__pycache__/
*.pyc
*.pyo
.DS_Store

# Per-run scraper debug dumps (raw HTML, screenshots, captured JSON) --
# uploaded as a workflow artifact instead, not meant to be committed. See
# add-paths in scrape_microval.yml / scrape_aoac.yml, which restricts what
# peter-evans/create-pull-request actually commits to data/ and web/.
debug/

# Cloudflare Worker (chat proxy)
worker/node_modules/
worker/.wrangler/
worker/.dev.vars
# package-lock.json is deliberately NOT ignored: Cloudflare's Git build runs
# `npm ci` from it, so committing it is what pins wrangler and makes a build
# reproducible. Without it the build resolves ^ ranges afresh every time and
# a bad upstream release breaks a deploy that changed nothing here.
