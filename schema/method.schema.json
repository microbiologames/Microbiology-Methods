{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microbiologames/microbiology-methods/schema/method.schema.json",
  "title": "Validated microbiology method",
  "description": "Canonical, normalized record for one validated microbiology analysis method, merged from a certification source (NF-Validation, MicroVal, AOAC-RI). This is the target shape after normalization -- raw per-source scrape output lives under data/<source>/ and does not need to match this shape exactly.",
  "type": "object",
  "required": ["id", "source", "source_certificate_number", "commercial_name", "target_organism", "action", "validation_scope", "certification", "traceability"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable slug, e.g. 'nf-validation--bio-12-21-12-06'"
    },
    "source": {
      "type": "string",
      "enum": ["NF-VALIDATION", "MICROVAL", "AOAC-RI"]
    },
    "source_certificate_number": {
      "type": "string",
      "description": "Certificate/license number exactly as printed by the certifying body, e.g. 'BIO 12/21-12/06', '022203', 'NF-EN-ISO-16140-...'."
    },
    "commercial_name": { "type": "string" },
    "manufacturer": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address_raw": { "type": "string" },
        "represented_in_europe": { "type": ["string", "null"] },
        "site_of_production": { "type": ["string", "null"] }
      }
    },
    "method_type": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["detection", "enumeration", "confirmation", "identification", "screening"]
        },
        "category": {
          "type": "string",
          "enum": ["culture_media", "molecular_pcr", "immunological_elisa", "flow_cytometry", "chromogenic_agar", "biochemical", "other"]
        }
      }
    },
    "target_organism": {
      "type": "object",
      "required": ["normalized"],
      "properties": {
        "normalized": {
          "type": "string",
          "description": "Normalized organism/analyte name, e.g. 'Salmonella spp.', 'Listeria monocytogenes', 'STEC', 'Antibiotic residues'."
        },
        "raw": { "type": "string" }
      }
    },
    "reference_method": {
      "type": "object",
      "properties": {
        "standard": {
          "type": "string",
          "description": "e.g. 'NF EN ISO 6579-1', 'ISO 21528-2:2017', 'FDA BAM Ch. 10 (2017)', 'USDA FSIS MLG 5.09'."
        },
        "raw": { "type": "string" }
      }
    },
    "validation_scope": {
      "type": "object",
      "required": ["raw"],
      "properties": {
        "raw": { "type": "string" },
        "matrices": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Normalized matrix/food-category tags, e.g. ['raw meat', 'dairy', 'environmental swabs']."
        },
        "excluded_matrices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "max_test_portion_g": { "type": ["number", "null"] }
      }
    },
    "study_design": {
      "type": "object",
      "properties": {
        "protocol_standard": {
          "type": "string",
          "description": "e.g. 'EN ISO 16140-2:2016', 'AOAC Performance Tested Methods program'."
        },
        "study_type": {
          "type": "string",
          "enum": ["single-lab", "multi-lab", "collaborative", "unknown"]
        },
        "number_of_labs": { "type": ["integer", "null"] },
        "number_of_samples": { "type": ["integer", "null"] }
      }
    },
    "certification": {
      "type": "object",
      "required": ["original_date"],
      "properties": {
        "original_date": { "type": ["string", "null"], "format": "date" },
        "renewal_dates": { "type": "array", "items": { "type": "string", "format": "date" } },
        "extension_dates": { "type": "array", "items": { "type": "string", "format": "date" } },
        "current_expiry": { "type": ["string", "null"], "format": "date" },
        "status": { "type": "string", "enum": ["active", "expired", "unknown"] }
      }
    },
    "performance": {
      "type": ["object", "null"],
      "description": "Only populated when a detailed validation/summary report (not just the certificate) has been mined. Absence does not mean the method lacks these data -- it means we haven't extracted them yet.",
      "properties": {
        "relative_trueness": {
          "type": "object",
          "properties": {
            "bias_log": { "type": ["number", "null"] },
            "sd_log": { "type": ["number", "null"] },
            "n_samples": { "type": ["integer", "null"] },
            "n_interpretable": { "type": ["integer", "null"] }
          }
        },
        "accuracy_profile": {
          "type": "object",
          "properties": {
            "acceptability_limit_log": { "type": ["number", "null"] },
            "matrices_tested": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "matrix": { "type": "string" },
                  "within_limits": { "type": ["boolean", "null"] }
                }
              }
            }
          }
        },
        "lod50": { "type": ["number", "null"] },
        "loq_log": { "type": ["number", "null"] },
        "inclusivity": {
          "type": "object",
          "properties": {
            "n_tested": { "type": ["integer", "null"] },
            "n_correctly_detected": { "type": ["integer", "null"] }
          }
        },
        "exclusivity": {
          "type": "object",
          "properties": {
            "n_tested": { "type": ["integer", "null"] },
            "n_correctly_negative": { "type": ["integer", "null"] }
          }
        },
        "sensitivity_specificity": {
          "type": "object",
          "properties": {
            "sensitivity_pct": { "type": ["number", "null"] },
            "specificity_pct": { "type": ["number", "null"] }
          }
        }
      }
    },
    "traceability": {
      "type": "object",
      "required": ["source_document_type", "extraction_confidence"],
      "properties": {
        "source_document_type": {
          "type": "string",
          "enum": ["certificate_list_pdf", "certificate_pdf", "summary_validation_report", "live_web_page"]
        },
        "source_document_url": { "type": ["string", "null"], "format": "uri" },
        "extraction_date": { "type": ["string", "null"], "format": "date" },
        "extraction_confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
