{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microbiologames/microbiology-methods/schema/method.schema.json",
  "title": "Validated microbiology method",
  "description": "Canonical, normalized record for one validated microbiology analysis method, merged from a certification source (NF-Validation, MicroVal, AOAC-RI). This is the target shape after normalization -- raw per-source scrape output lives under data/<source>/ and does not need to match this shape exactly.",
  "type": "object",
  "required": ["id", "source", "source_certificate_number", "commercial_name", "target_organism", "method_type", "validation_scope", "certification", "traceability"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable slug, e.g. 'nf-validation--bio-12-21-12-06'"
    },
    "source": {
      "type": "string",
      "enum": ["NF-VALIDATION", "MICROVAL", "AOAC-RI"]
    },
    "source_certificate_number": {
      "type": "string",
      "description": "Certificate/license number exactly as printed by the certifying body, e.g. 'BIO 12/21-12/06', '022203', 'NF-EN-ISO-16140-...'."
    },
    "commercial_name": {
      "type": "string",
      "description": "Used as the cross-source product grouping key (exact/near-exact match). A different commercial name between two certifying bodies is treated as a different method, not a variant -- per the project's data-matching policy."
    },
    "manufacturer": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "address_raw": { "type": ["string", "null"] },
        "represented_in_europe": { "type": ["string", "null"] },
        "site_of_production": { "type": ["string", "null"] }
      }
    },
    "method_type": {
      "type": "object",
      "properties": {
        "action": {
          "type": ["string", "null"],
          "enum": ["detection", "enumeration", "confirmation", "identification", "screening", null]
        },
        "category": {
          "type": ["string", "null"],
          "enum": ["culture_media", "molecular_pcr", "immunological_elisa", "flow_cytometry", "chromogenic_agar", "biochemical", "other", null]
        }
      }
    },
    "target_organism": {
      "type": "object",
      "required": ["normalized"],
      "properties": {
        "normalized": {
          "type": ["string", "null"],
          "description": "Normalized organism/analyte name, e.g. 'Salmonella spp.', 'Listeria monocytogenes', 'STEC', 'Antibiotic residues'. Null means not yet resolved (e.g. an ambiguous cross-source match), not that the method has no target."
        },
        "raw": { "type": ["string", "null"] }
      }
    },
    "reference_method": {
      "type": "object",
      "properties": {
        "standard": {
          "type": ["string", "null"],
          "description": "e.g. 'NF EN ISO 6579-1', 'ISO 21528-2:2017', 'FDA BAM Ch. 10 (2017)', 'USDA FSIS MLG 5.09'."
        },
        "raw": { "type": ["string", "null"] }
      }
    },
    "validation_scope": {
      "type": "object",
      "required": ["raw"],
      "properties": {
        "raw": { "type": "string" },
        "matrices": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Normalized matrix/food-category tags, e.g. ['raw meat', 'dairy', 'environmental swabs']."
        },
        "excluded_matrices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "max_test_portion_g": { "type": ["number", "null"] }
      }
    },
    "study_design": {
      "type": "object",
      "properties": {
        "protocol_standard": {
          "type": "string",
          "description": "e.g. 'EN ISO 16140-2:2016', 'AOAC Performance Tested Methods program'."
        },
        "study_type": {
          "type": "string",
          "enum": ["single-lab", "multi-lab", "collaborative", "unknown"]
        },
        "number_of_labs": { "type": ["integer", "null"] },
        "number_of_samples": { "type": ["integer", "null"] }
      }
    },
    "certification": {
      "type": "object",
      "required": ["original_date"],
      "properties": {
        "original_date": { "type": ["string", "null"], "format": "date" },
        "renewal_dates": { "type": "array", "items": { "type": "string", "format": "date" } },
        "extension_dates": { "type": "array", "items": { "type": "string", "format": "date" } },
        "current_expiry": { "type": ["string", "null"], "format": "date" },
        "status": { "type": "string", "enum": ["active", "expired", "unknown"] }
      }
    },
    "performance": {
      "type": ["object", "null"],
      "description": "Only populated when a detailed validation/summary report (not just the certificate) has been mined. Absence does not mean the method lacks these data -- it means we haven't extracted them yet. Vocabulary follows ISO 16140-2:2016 (method comparison study + accuracy profile + interlaboratory study). Exactly one of `qualitative`/`quantitative` should be populated, matching `method_type.action` (detection -> qualitative, enumeration -> quantitative).",
      "properties": {
        "method_nature": { "type": "string", "enum": ["qualitative", "quantitative"] },

        "qualitative": {
          "type": "object",
          "description": "Detection methods. 'Relative trueness' here is the qualitative concordance-based metric from the ISO 16140-2 method comparison study -- NOT the same concept as the quantitative bias below, despite the shared name.",
          "properties": {
            "method_comparison_by_category": {
              "type": "array",
              "description": "One entry per food category tested in the method comparison study.",
              "items": {
                "type": "object",
                "properties": {
                  "category": { "type": "string" },
                  "sensitivity_alternative_pct": { "type": ["number", "null"] },
                  "sensitivity_reference_pct": { "type": ["number", "null"] },
                  "relative_trueness_pct": { "type": ["number", "null"] },
                  "false_positive_ratio_alternative_pct": { "type": ["number", "null"] },
                  "negative_deviations_summary": {
                    "type": ["string", "null"],
                    "description": "Free-text summary of discordant negative results, since source reports usually itemize these per sample rather than as a single stat."
                  },
                  "lod50_alternative": { "type": ["number", "null"] },
                  "lod50_reference": { "type": ["number", "null"] },
                  "rlod": {
                    "type": ["number", "null"],
                    "description": "Relative LOD = LOD50_alternative / LOD50_reference."
                  }
                }
              }
            },
            "inclusivity": { "$ref": "#/$defs/strain_panel_result" },
            "exclusivity": { "$ref": "#/$defs/strain_panel_result" },
            "interlaboratory_study": {
              "type": "object",
              "properties": {
                "n_labs": { "type": ["integer", "null"] },
                "by_level": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "level": { "type": "string" },
                      "sensitivity_alternative_pct": { "type": ["number", "null"] },
                      "sensitivity_reference_pct": { "type": ["number", "null"] },
                      "relative_trueness_pct": { "type": ["number", "null"] },
                      "false_positive_ratio_alternative_pct": { "type": ["number", "null"] },
                      "lod50": { "type": ["number", "null"] },
                      "rlod": { "type": ["number", "null"] }
                    }
                  }
                }
              }
            }
          }
        },

        "quantitative": {
          "type": "object",
          "description": "Enumeration methods.",
          "properties": {
            "relative_trueness_by_category": {
              "type": "array",
              "description": "Bias (in log10 units) between alternative and reference method, per food category.",
              "items": {
                "type": "object",
                "properties": {
                  "category": { "type": "string" },
                  "bias_log": { "type": ["number", "null"] },
                  "sd_log": { "type": ["number", "null"] },
                  "n_samples": { "type": ["integer", "null"] },
                  "n_interpretable": { "type": ["integer", "null"] },
                  "lower_limit_95": { "type": ["number", "null"] },
                  "upper_limit_95": { "type": ["number", "null"] }
                }
              }
            },
            "accuracy_profile": {
              "type": "object",
              "properties": {
                "acceptability_limit_log": { "type": ["number", "null"] },
                "by_matrix": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "matrix": { "type": "string" },
                      "sd_repeatability_reference": { "type": ["number", "null"] },
                      "sd_repeatability_alternative": { "type": ["number", "null"] },
                      "samples_out_of_beta_eti": {
                        "type": "array",
                        "description": "Samples/inoculation levels whose beta-expectation tolerance interval fell outside the acceptability limit.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "sample_id": { "type": ["string", "null"] },
                            "level": { "type": ["string", "null"] },
                            "note": { "type": ["string", "null"] }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "loq_log": { "type": ["number", "null"] },
            "inclusivity": { "$ref": "#/$defs/strain_panel_result" },
            "exclusivity": { "$ref": "#/$defs/strain_panel_result" },
            "interlaboratory_study": {
              "type": "object",
              "properties": {
                "n_labs": { "type": ["integer", "null"] },
                "by_level": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "level": { "type": "string" },
                      "sr_repeatability_reference": { "type": ["number", "null"] },
                      "sr_repeatability_alternative": { "type": ["number", "null"] },
                      "sl_between_labs": { "type": ["number", "null"] },
                      "reproducibility_sr_reference": { "type": ["number", "null"] },
                      "reproducibility_sr_alternative": { "type": ["number", "null"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "traceability": {
      "type": "object",
      "required": ["source_document_type", "extraction_confidence"],
      "properties": {
        "source_document_type": {
          "type": "string",
          "enum": ["certificate_list_pdf", "certificate_pdf", "summary_validation_report", "live_web_page"]
        },
        "source_document_url": { "type": ["string", "null"], "format": "uri" },
        "extraction_date": { "type": ["string", "null"], "format": "date" },
        "extraction_confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "notes": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "strain_panel_result": {
      "type": "object",
      "description": "Inclusivity (target strains) or exclusivity (non-target strains) panel result.",
      "properties": {
        "n_tested": { "type": ["integer", "null"] },
        "n_correctly_detected": {
          "type": ["integer", "null"],
          "description": "For inclusivity: strains correctly detected. For exclusivity: strains correctly NOT detected."
        },
        "discrepancies": {
          "type": "array",
          "description": "Strains whose result diverged from the reference method or from expectation.",
          "items": {
            "type": "object",
            "properties": {
              "strain": { "type": "string" },
              "note": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
